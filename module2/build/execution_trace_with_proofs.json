    "code": "from collections import OrderedDict\n\nclass LRUCache:\n    \"\"\"V3: Production OrderedDict with unhashable key serialization and true O(1) ops.\"\"\"\n    def __init__(self, capacity: int):\n        self.capacity = max(0, capacity)\n        self.cache = OrderedDict()\n\n    def _make_hashable(self, key):\n        if isinstance(key, (list, dict, set)):\n            return f\"__unhashable_repr__{repr(key)}\"\n        return key\n\n    def get(self, key):\n        h_key = self._make_hashable(key)\n        if h_key not in self.cache:\n            return -1\n        self.cache.move_to_end(h_key)\n        return self.cache[h_key]\n\n    def put(self, key, value):\n        if self.capacity <= 0:\n            return\n        h_key = self._make_hashable(key)\n        if h_key in self.cache:\n            self.cache.move_to_end(h_key)\n        elif len(self.cache) >= self.capacity:\n            self.cache.popitem(last=False)\n        self.cache[h_key] = value\n",
