# ==============================================================================
# AutoEvolve Protocol - Module 3 Environment Variables
# ==============================================================================

# Lighthouse IPFS/Filecoin API Key
# Sign up and get your free API key at https://files.lighthouse.storage
LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here

# Base Sepolia RPC URL (e.g. public node, Alchemy, or Infura)
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com

# Optional: Deployed on-chain AutoEvolveRegistry smart contract address
# If omitted or un-deployed, Module 3 automatically uses the zero-gas Local DataDAO backup ledger
# REGISTRY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

